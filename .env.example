# Leave DATABASE_URL empty in development: an embedded Postgres (PGlite) is used and stored in .data/pgdata
# In production set a real Postgres URL, e.g. postgres://user:pass@host:5432/misalhub
DATABASE_URL=
# Long random string used to sign login sessions
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public ordering page / UPI
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_BRAND_PHONE=919004167448
